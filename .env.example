# Copy to .env and fill in real values. NEVER commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-string
JWT_EXPIRE_MINUTES=60
# Teachers must know this code to register (prevents students self-promoting)
TEACHER_INVITE_CODE=change-me-teacher-code

# --- Database ---
# Local:  sqlite:///./portal.db
# Cloud (Supabase / Neon / Render Postgres free tier):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./portal.db

# --- Object storage ---
# local = ./uploads folder | s3 = any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage, MinIO)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Web ---
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_LOGIN_PER_MIN=10
DEFAULT_MAX_FILE_MB=10
